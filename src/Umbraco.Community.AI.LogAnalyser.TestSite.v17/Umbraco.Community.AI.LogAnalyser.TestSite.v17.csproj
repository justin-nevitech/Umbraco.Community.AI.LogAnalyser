<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CompressionEnabled>false</CompressionEnabled> <!-- Disable compression. E.g. for umbraco backoffice files. These files should be precompressed by node and not let dotnet handle it -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Clean" Version="7.0.8" />
    <PackageReference Include="Umbraco.AI" Version="17.3.1" />
    <PackageReference Include="Umbraco.AI.Agent" Version="17.1.4" />
    <PackageReference Include="Umbraco.AI.Agent.Copilot" Version="17.0.4" />
    <PackageReference Include="Umbraco.AI.Amazon" Version="17.1.0" />
    <PackageReference Include="Umbraco.AI.Anthropic" Version="17.1.0" />
    <PackageReference Include="Umbraco.AI.Google" Version="17.0.3" />
    <PackageReference Include="Umbraco.AI.MicrosoftFoundry" Version="17.0.3" />
    <PackageReference Include="Umbraco.AI.OpenAI" Version="17.2.0" />
    <PackageReference Include="Umbraco.AI.Prompt" Version="17.2.3" />
    <PackageReference Include="Umbraco.Cms" Version="17.6.2" />
    <!-- Required by ModelsBuilder ModelsMode=InMemoryAuto: provides Razor runtime compilation
         so the front-end views (which use generated PublishedModels) can be compiled. -->
    <PackageReference Include="Umbraco.Cms.DevelopmentMode.Backoffice" Version="17.6.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Opt-in to app-local ICU to ensure consistent globalization APIs across different platforms -->
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <PackageReference Include="uSync" Version="17.3.7" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" Condition="$(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx')))" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build the package in its Umbraco 17 variant (the default; selects v17 Umbraco refs). -->
    <ProjectReference Include="..\Umbraco.Community.AI.LogAnalyser.v17\Umbraco.Community.AI.LogAnalyser.v17.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Razor files are needed for the backoffice to work correctly -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Remove RazorCompileOnBuild and RazorCompileOnPublish when not using ModelsMode InMemoryAuto -->
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
    <UserSecretsId>e6e4e891-9f6b-496b-adc6-3e78d59cdda5</UserSecretsId>
  </PropertyGroup>

</Project>
