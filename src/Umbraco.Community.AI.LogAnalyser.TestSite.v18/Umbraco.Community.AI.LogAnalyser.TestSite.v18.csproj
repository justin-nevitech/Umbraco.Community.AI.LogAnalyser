<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CompressionEnabled>false</CompressionEnabled> <!-- Disable compression. E.g. for umbraco backoffice files. These files should be precompressed by node and not let dotnet handle it -->
  </PropertyGroup>

  <!--
    Umbraco 18 test site. Mirrors TestSite.v17 but on the Umbraco 18 package line, and
    references the package with UmbracoMajor=18 so the v18 code path is exercised end to end.
    See docs/BUILDING.md.
  -->
  <ItemGroup>
    <PackageReference Include="Clean" Version="8.0.1" />
    <PackageReference Include="Umbraco.AI" Version="18.3.1" />
    <PackageReference Include="Umbraco.AI.Agent" Version="18.1.4" />
    <PackageReference Include="Umbraco.AI.Agent.Copilot" Version="18.0.5" />
    <PackageReference Include="Umbraco.AI.Amazon" Version="18.1.0" />
    <PackageReference Include="Umbraco.AI.Anthropic" Version="18.1.0" />
    <PackageReference Include="Umbraco.AI.Google" Version="18.0.3" />
    <PackageReference Include="Umbraco.AI.MicrosoftFoundry" Version="18.0.3" />
    <PackageReference Include="Umbraco.AI.OpenAI" Version="18.2.0" />
    <PackageReference Include="Umbraco.AI.Prompt" Version="18.2.3" />
    <PackageReference Include="Umbraco.Cms" Version="18.1.1" />
    <!-- Required by ModelsBuilder ModelsMode=InMemoryAuto: provides Razor runtime compilation
         so the front-end views (which use generated PublishedModels) can be compiled. -->
    <PackageReference Include="Umbraco.Cms.DevelopmentMode.Backoffice" Version="18.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Opt-in to app-local ICU to ensure consistent globalization APIs across different platforms -->
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <PackageReference Include="uSync" Version="18.1.1" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" Condition="$(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx')))" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Umbraco 18 variant of the package (same sources as the v17 project, compiled
         against Umbraco 18 with UMBRACO_18 defined). -->
    <ProjectReference Include="..\Umbraco.Community.AI.LogAnalyser.v18\Umbraco.Community.AI.LogAnalyser.v18.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Razor files are needed for the backoffice to work correctly -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Remove RazorCompileOnBuild and RazorCompileOnPublish when not using ModelsMode InMemoryAuto -->
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
    <UserSecretsId>a9970d43-4430-4bb7-a48d-de087b073e1b</UserSecretsId>
  </PropertyGroup>

</Project>
