<Project>

  <!--
    Shared definition for the two test projects that run this suite:

      Umbraco.Community.AI.LogAnalyser.Tests.v17\...v17.csproj  -> against the Umbraco 17 package
      Umbraco.Community.AI.LogAnalyser.Tests.v18\...v18.csproj  -> against the Umbraco 18 package

    This directory (Umbraco.Community.AI.LogAnalyser.Tests) is NOT a project. It is the single
    home for the test sources, mirroring how Umbraco.Community.AI.LogAnalyser holds the shared
    product sources. Both wrappers compile these same files, so every test runs against both
    Umbraco majors and the UMBRACO_18 code path is exercised rather than merely compiled.

    Add new test files here; both wrappers pick them up automatically.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>

    <!-- Only the COMPILE globs are replaced: the sources are shared from this directory and the
         default glob is relative to each wrapper's own folder. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NSubstitute" Version="6.*" />
    <PackageReference Include="FluentAssertions" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.*" />
  </ItemGroup>

  <!-- Shared test sources. Each wrapper's own bin/obj are excluded. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)**\*.cs"
             Exclude="$(MSBuildThisFileDirectory)bin\**\*.cs;$(MSBuildThisFileDirectory)obj\**\*.cs" />
  </ItemGroup>

</Project>
